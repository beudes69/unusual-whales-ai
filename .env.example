# Toutes les variables sont facultatives. Ne placez jamais de secret dans ce fichier.
OKX_AI_PRO_APP__ENVIRONMENT=development
OKX_AI_PRO_APP__TIMEZONE=UTC
OKX_AI_PRO_APP__DATA_DIRECTORY=data
OKX_AI_PRO_LOGGING__LEVEL=INFO
OKX_AI_PRO_LOGGING__CONSOLE_ENABLED=true
OKX_AI_PRO_LOGGING__FILE_ENABLED=true
OKX_AI_PRO_LOGGING__DIRECTORY=logs
OKX_AI_PRO_OKX__REQUEST_TIMEOUT_SECONDS=10.0
OKX_AI_PRO_OKX__WEBSOCKET_RECEIVE_TIMEOUT_SECONDS=20.0
OKX_AI_PRO_OKX__WEBSOCKET_ACK_TIMEOUT_SECONDS=5.0
